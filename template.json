{
  "name": "EMLESS",
  "description": "EMLESS — Next-Gen Proxy & V2Ray/Xray/MTProto Control Center with RVG Modular Transport, Subscription Engine, and Persistent Volume Storage",
  "services": [
    {
      "name": "emless-panel",
      "icon": "https://raw.githubusercontent.com/user/repo/main/public/icon.png",
      "build": {
        "builder": "NIXPACKS",
        "buildCommand": "npm run build"
      },
      "deploy": {
        "startCommand": "npm start",
        "healthcheckPath": "/health",
        "healthcheckTimeout": 100,
        "restartPolicyType": "ON_FAILURE",
        "restartPolicyMaxRetries": 10
      },
      "volumes": [
        {
          "mountPath": "/data"
        }
      ],
      "tcpProxies": [
        {
          "applicationPort": 8444
        }
      ],
      "variables": {
        "ADMIN_USERNAME": {
          "description": "Administrator login username",
          "defaultValue": "admin"
        },
        "ADMIN_PASSWORD": {
          "description": "Administrator login password (change on initial setup)",
          "defaultValue": "admin"
        },
        "SECRET_KEY": {
          "description": "Cryptographically secure token & session secret",
          "generator": "secret_key"
        },
        "DB_PATH": {
          "description": "Path to persistent database on Railway Volume",
          "defaultValue": "/data/panel.db"
        },
        "DOMAIN": {
          "description": "Public domain assigned to EMLESS service",
          "defaultValue": "${{RAILWAY_PUBLIC_DOMAIN}}"
        },
        "MTPROXY_ENABLED": {
          "description": "Enable Telegram MTProto Proxy service",
          "defaultValue": "true"
        },
        "MTPROXY_PORT": {
          "description": "Internal port for Telegram MTProto TCP proxy",
          "defaultValue": "8444"
        },
        "MTPROXY_PUBLIC_HOST": {
          "description": "Railway TCP Proxy public host for Telegram proxy",
          "defaultValue": "${{RAILWAY_TCP_PROXY_DOMAIN}}"
        },
        "MTPROXY_PUBLIC_PORT": {
          "description": "Railway TCP Proxy public port for Telegram proxy",
          "defaultValue": "${{RAILWAY_TCP_PROXY_PORT}}"
        },
        "WORKERS": {
          "description": "Number of server worker processes",
          "defaultValue": "1"
        },
        "DEFAULT_TRANSPORT_MODE": {
          "description": "Default inbound connection transport mode ('standard' or 'cloak_ws')",
          "defaultValue": "standard"
        },
        "CLOAK_WS_ENABLED": {
          "description": "Enable Cloak WS modular transport layer",
          "defaultValue": "true"
        }
      }
    }
  ]
}
